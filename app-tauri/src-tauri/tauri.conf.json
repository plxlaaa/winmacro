{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinMacro",
  "version": "2.1.0",
  "identifier": "com.plxlaaa.winmacro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WinMacro — 脚本录制与执行",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0RjM2QThGRTBBQzE4M0MKUldROEdLemdqMnJ6VlBKWlZwZ2ptdVJaSFRwc1oxcmRCN2w5YjNMaGZxWjBRdGZsYkdKR3hDdkoK",
      "endpoints": [
        "https://github.com/plxlaaa/winmacro/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
